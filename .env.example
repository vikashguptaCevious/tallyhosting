# Copy values into .env.production / .env.uat / .env.development as needed.
# Vite exposes only variables prefixed with VITE_ to the client.

VITE_WEBSITE_URL=https://tallyhosting.com
VITE_CUSTOMER_PORTAL_URL=https://customer.cloudorc.com
VITE_PARTNER_PORTAL_URL=https://partner.ceviouscloud.com
VITE_API_URL=

# Server-side only (never exposed to the browser) — required by npm start.
# Leads are posted to /api/bitrix/lead on the same origin.
BITRIX_WEBHOOK_URL=
BITRIX_ASSIGNED_BY_ID=3940

# Cevious Cloud public API base (must end with /api/v1, no trailing slash)
# Used for Demo Request + public Blogs (platform=TALLYHOSTING)
# Local:  http://localhost:8081/api/v1
# UAT:    https://<uat-api-host>/api/v1
# Prod:   https://api.cloudorc.com/api/v1
VITE_CEVIOUS_API_BASE=http://localhost:8081/api/v1
