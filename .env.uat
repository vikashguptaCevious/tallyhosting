# UAT — used by: npm run build:uat / npm run dev:uat
# Note: Vite gives this file priority over `.env`, so UAT values must live here.
# For machine-specific overrides use `.env.uat.local` (git-ignored, highest priority).
VITE_WEBSITE_URL=https://uat.tallyhosting.com
VITE_CUSTOMER_PORTAL_URL=https://customer.uat.tallyhosting.com
VITE_PARTNER_PORTAL_URL=https://partner-uat.cloudorc.com
VITE_API_URL=
VITE_CEVIOUS_API_BASE=https://api-uat.cloudorc.com/api/v1
  